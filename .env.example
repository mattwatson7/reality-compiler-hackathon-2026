# Server only. Keep both paid flags false until explicit human authorization.
# Key is read from process environment or this root .env; never use VITE_*.
MODEL_API_KEY=
META_ENABLE_PAID_INFERENCE=false
META_SMOKE_TEST_APPROVED=false
META_COMPILER=local_rules
META_SPARK_VISUAL=false
# After approval, META_COMPILER=muse_wonder enables semantic compilation on SAM jobs.
# META_SPARK_VISUAL=true opts into final-state image interpretation when required.
PROVIDER_MODE=fixture
# Set local_cv to make API uploads default to first-frame initialization.
# The studio explicitly requests local_cv by default in either server mode.
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=300
MEDIA_TTL_SECONDS=3600
# Optional absolute path; otherwise system FFmpeg or bundled imageio-ffmpeg is used.
# FFMPEG_BINARY=C:/ffmpeg/bin/ffmpeg.exe
# Do not put secrets in VITE_* variables: Vite embeds those in browser code.
